# Copy this file to ".env" and restart the dev server to change providers.
# Defaults to the built-in mock providers, so no keys are required.
#
# WARNING: VITE_* variables are bundled into the browser code. Use these only
# for local experiments. For production, call the APIs from your own backend.

# AI provider: mock | openai
VITE_AI_PROVIDER=mock
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_MODEL=gpt-4o-mini

# Search provider: mock | tavily
VITE_SEARCH_PROVIDER=mock
# VITE_TAVILY_API_KEY=tvly-...
